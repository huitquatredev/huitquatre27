---
// Smooth scroll Lenis piloté par le ticker GSAP (une seule boucle, pas de rAF concurrent).
// Désactivé en reduced-motion. ScrollTrigger (page d'accueil) est branché à la demande.
---

<script>
  import Lenis from "lenis"
  import { gsap } from "gsap"

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (!reduceMotion) {
    const lenis = new Lenis({ duration: 1.1, smoothWheel: true })
    ;(window as any).lenis = lenis

    // gsap.ticker passe des secondes, lenis.raf attend des millisecondes.
    const update = (time: number) => lenis.raf(time * 1000)
    gsap.ticker.add(update)
    gsap.ticker.lagSmoothing(0)

    // ScrollTrigger n'est présent que sur les pages qui en ont (manifeste) :
    // on ne le charge pas sur les autres.
    if (document.querySelector('[data-sticky-title="wrap"]')) {
      import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger)
        lenis.on("scroll", ScrollTrigger.update)
        ScrollTrigger.refresh()
      })
    }

    // Le rideau de transition bloque le scroll : on met Lenis en pause, puis on repart.
    if (document.documentElement.classList.contains("hq-wipe-go")) lenis.stop()
    window.addEventListener("loaderComplete", () => lenis.start())
    window.addEventListener("hq:transition-start", () => lenis.stop())

    // Ancres internes : Lenis scrolle, l'URL reste à jour. -80px pour le header fixe.
    document.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return

      const anchor = (event.target as HTMLElement).closest?.(
        "a[href^='#']"
      ) as HTMLAnchorElement | null
      const href = anchor?.getAttribute("href")
      if (!href || href === "#") return

      const target = document.getElementById(href.slice(1))
      if (!target) return

      event.preventDefault()
      lenis.scrollTo(target as HTMLElement)
      history.pushState(null, "", href)
    })
  }
</script>
