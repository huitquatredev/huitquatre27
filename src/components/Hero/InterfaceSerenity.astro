---
// InterfaceSerenity — ... à la sérénité (mirrors InterfaceContrast, Storyblok window)
---

<section class="serenity" id="serenity">
  <div class="serenity__sticky">
    <div class="serenity__header">
      <h2 class="serenity__title">
        <span class="serenity__word"><span class="serenity__letter">.</span><span class="serenity__letter">.</span><span class="serenity__letter">.</span></span>
        <span class="serenity__word">&nbsp;</span>
        <span class="serenity__word"><span class="serenity__letter">à</span></span>
        <span class="serenity__word">&nbsp;</span>
        <span class="serenity__word"><span class="serenity__letter">l</span><span class="serenity__letter">a</span></span>
        <span class="serenity__word">&nbsp;</span>
        <span class="serenity__word serenity__accent"><span class="serenity__letter">s</span><span class="serenity__letter">é</span><span class="serenity__letter">r</span><span class="serenity__letter">é</span><span class="serenity__letter">n</span><span class="serenity__letter">i</span><span class="serenity__letter">t</span><span class="serenity__letter">é</span></span>
      </h2>
    </div>

      <div class="serenity__scene" id="serenity-scene">
      <div class="serenity__glow"></div>
      <div class="serenity__stage" data-serenity-stage>
        <div class="float float--publish">
          <div class="float__inner float__inner--good">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 14L14 2M14 2H6M14 2v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Publier
          </div>
        </div>
        <div class="float float--seo">
          <div class="float__inner float__inner--good">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.3"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            SEO
            <span class="float__badge">100</span>
          </div>
        </div>
        <div class="float float--perf">
          <div class="float__inner float__inner--good">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M9 1L3 9h4l-1 6 6-8H8l1-6z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Perf
            <span class="float__badge">100</span>
          </div>
        </div>
        <div class="float float--ai">
          <div class="float__inner float__inner--good float__inner--icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>
          </div>
        </div>
        <div class="float float--check">
          <div class="float__inner float__inner--good float__inner--icon">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3"/><path d="M6 10l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <div class="serenity__sb" data-serenity-sb>
          <div class="sb__shine"></div>
          <div class="sb__chrome">
            <div class="sb__dots"><span></span><span></span><span></span></div>
            <div class="sb__url">app.storyblok.com</div>
          </div>
          <div class="sb__body">
            <div class="sb__topbar">
              <div class="sb__brand">
                <svg class="sb__brand-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
                Storyblok
                <span class="sb__space">huitquatre</span>
              </div>
              <div class="sb__topbar-actions">
                <span class="sb__publish-btn">Publier</span>
              </div>
            </div>
            <div class="sb__layout">
              <aside class="sb__sidebar">
                <div class="sb__sidebar-title">Blocs</div>
                <nav class="sb__nav">
                  <div class="sb__nav-item sb__nav-item--active">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="2" width="12" height="4" rx="1"/><rect x="2" y="8" width="7" height="6" rx="1"/><rect x="11" y="8" width="3" height="6" rx="1"/></svg>
                    Hero
                  </div>
                  <div class="sb__nav-item">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 4h12v1H2V4zm0 3.5h12v1H2v-1zM2 11h12v1H2v-1z"/></svg>
                    Texte
                  </div>
                  <div class="sb__nav-item">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="6"/></svg>
                    Image
                  </div>
                  <div class="sb__nav-item">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3 3h10v10H3V3z"/></svg>
                    Galerie
                  </div>
                  <div class="sb__nav-item">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="5" width="12" height="6" rx="2"/></svg>
                    CTA
                  </div>
                </nav>
              </aside>
              <main class="sb__main">
                <div class="sb__content">
                  <div class="sb__notification sb__notification--success" id="sb-notif-publish">
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M6 10l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Publié — site à jour
                  </div>
                  <div class="sb__notification sb__notification--success" id="sb-notif-seo">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.3"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    SEO 100/100 — parfait
                  </div>
                  <div class="sb__preview">
                    <div class="sb__preview-hero">
                      <div class="sb__preview-title"></div>
                      <div class="sb__preview-title sb__preview-title--short"></div>
                      <div class="sb__preview-btn"></div>
                    </div>
                    <div class="sb__preview-blocks">
                      <div class="sb__preview-block"><div class="sb__preview-icon"></div><div class="sb__preview-line"></div></div>
                      <div class="sb__preview-block"><div class="sb__preview-icon sb__preview-icon--accent"></div><div class="sb__preview-line"></div></div>
                      <div class="sb__preview-block"><div class="sb__preview-icon"></div><div class="sb__preview-line"></div></div>
                    </div>
                  </div>
                  <div class="sb__widgets">
                    <div class="sb__widget">
                      <div class="sb__widget-header">Performance</div>
                      <div class="sb__widget-value sb__widget-value--good">100</div>
                      <div class="sb__widget-label">PageSpeed</div>
                    </div>
                    <div class="sb__widget">
                      <div class="sb__widget-header">Sécurité</div>
                      <div class="sb__widget-value sb__widget-value--good">OK</div>
                      <div class="sb__widget-label">Évaluation</div>
                    </div>
                    <div class="sb__widget">
                      <div class="sb__widget-header">Coûts</div>
                      <div class="sb__widget-value sb__widget-value--accent">Inclus</div>
                      <div class="sb__widget-label">Maintenance</div>
                    </div>
                  </div>
                </div>
              </main>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .serenity { height: 250vh; background-color: var(--color-secondary); }
  .serenity__sticky {
    position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column; align-items: flex-start;
    padding: var(--space-3xl) var(--container-padding); overflow: hidden;
  }
  .serenity__header { text-align: left; z-index: 2; width: 100%; max-width: var(--container-max); margin: 0 auto; }
  .serenity__title {
    color: var(--color-primary); font-size: var(--text-4xl);
    text-transform: uppercase; letter-spacing: -0.03em;
    display: flex; flex-wrap: wrap;
  }
  .serenity__word { display: inline-flex; white-space: nowrap; }
  .serenity__letter { display: inline-block; opacity: 0; transform: translateY(20px); }
  .serenity__accent { color: var(--color-accent); }

  .serenity__scene {
    position: relative; width: 100%; max-width: 1000px; margin: 0 auto;
    flex: 1; display: flex; align-items: center; justify-content: center;
    perspective: 900px;
  }
  .serenity__glow {
    position: absolute; width: 60%; height: 50%; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(212,255,0,0.12) 0%, transparent 70%);
    filter: blur(50px); pointer-events: none; z-index: 0;
    transition: opacity 0.5s ease; opacity: 0.5;
  }
  .serenity__stage {
    position: relative; width: 100%; max-width: 700px; height: 450px; z-index: 1;
    transform-style: preserve-3d;
  }

  .float {
    position: absolute; will-change: transform;
    pointer-events: none; z-index: 2; opacity: 0;
  }
  .float__inner {
    display: flex; align-items: center; gap: 8px; padding: 10px 18px;
    border-radius: 12px; background: rgba(26,26,26,0.85);
    backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.8); font-family: var(--font-body);
    font-size: 14px; font-weight: 500; white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3), 0 0 40px -10px rgba(212,255,0,0.1);
  }
  .float__inner svg { flex-shrink: 0; opacity: 0.7; }
  .float__inner--icon { padding: 10px; border-radius: 12px; }
  .float__inner--good { border-color: rgba(40,200,64,0.35); background: rgba(20,50,25,0.85); color: #a0e8b0; }
  .float__badge {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 1px 6px; border-radius: 6px;
    background: rgba(72,199,100,0.2); color: #48c764;
    font-size: 11px; font-weight: 700;
  }
  .float--publish { top: 5%; right: 10%; }
  .float--seo { top: 22%; right: 5%; }
  .float--perf { bottom: 20%; right: 10%; }
  .float--ai { top: -6px; left: 10%; }
  .float--check { top: 45%; right: 5%; }

  .serenity__sb {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100%; max-width: 600px; border-radius: 12px; overflow: hidden;
    background: #1a1a1a; border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.05), 0 4px 16px rgba(0,0,0,0.4),
      0 12px 40px rgba(0,0,0,0.3), 0 0 80px -20px rgba(212,255,0,0.15);
    z-index: 1; opacity: 0;
    transform-style: preserve-3d; will-change: transform;
    transition: box-shadow 0.4s ease;
  }
  .sb__shine {
    position: absolute; inset: 0; z-index: 10; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.04) 45%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 55%, transparent 60%);
    background-size: 250% 100%; background-position: 200% 0; border-radius: 12px;
  }
  .sb__chrome {
    display: flex; align-items: center; gap: 12px; padding: 10px 14px;
    background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .sb__dots { display: flex; gap: 5px; }
  .sb__dots span { width: 8px; height: 8px; border-radius: 50%; }
  .sb__dots span:nth-child(1) { background: #ff5f57; }
  .sb__dots span:nth-child(2) { background: #febc2e; }
  .sb__dots span:nth-child(3) { background: #28c840; }
  .sb__url {
    flex: 1; background: rgba(255,255,255,0.04); padding: 5px 10px;
    border-radius: 4px; font-size: 11px; color: rgba(255,255,255,0.3); font-family: var(--font-mono);
  }
  .sb__body { background: #111; display: flex; flex-direction: column; }
  .sb__topbar {
    background: #161616; padding: 8px 16px; display: flex;
    justify-content: space-between; align-items: center; font-size: 12px; color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .sb__brand { display: flex; align-items: center; gap: 6px; font-weight: 600; }
  .sb__brand-icon { color: var(--color-accent); }
  .sb__space {
    margin-left: 6px; font-weight: 400; font-size: 11px; color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 10px;
  }
  .sb__topbar-actions { display: flex; align-items: center; gap: 8px; }
  .sb__publish-btn {
    background: var(--color-accent); color: #000;
    padding: 4px 12px; border-radius: 6px; font-size: 11px; font-weight: 700;
  }
  .sb__layout { display: flex; flex: 1; overflow: hidden; }
  .sb__sidebar { width: 180px; background: #141414; padding: 16px 0; flex-shrink: 0; border-right: 1px solid rgba(255,255,255,0.05); }
  .sb__sidebar-title {
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(255,255,255,0.4); padding: 0 16px 8px;
  }
  .sb__nav { display: flex; flex-direction: column; }
  .sb__nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: 13px; color: #a7aaad; }
  .sb__nav-item--active { background: rgba(212,255,0,0.12); color: var(--color-accent); border-left: 2px solid var(--color-accent); }
  .sb__main { flex: 1; background: #0a0a0a; overflow: hidden; }
  .sb__content { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .sb__notification {
    display: flex; align-items: center; gap: 8px; padding: 10px 12px;
    background: rgba(255,255,255,0.05); border-radius: 6px; font-size: 12px;
    color: rgba(255,255,255,0.7); border-left: 3px solid rgba(255,255,255,0.2);
    opacity: 0; transform: translateY(-10px);
  }
  .sb__notification svg { flex-shrink: 0; opacity: 0.8; }
  .sb__notification--success { border-left-color: #28c840; background: rgba(40,200,64,0.1); color: #a0e8b0; }
  .sb__preview {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px; padding: 14px;
  }
  .sb__preview-hero { margin-bottom: 12px; }
  .sb__preview-title {
    width: 80%; height: 10px; border-radius: 5px;
    background: rgba(255,255,255,0.15); margin-bottom: 6px;
  }
  .sb__preview-title--short {
    width: 55%;
    background: linear-gradient(90deg, rgba(212,255,0,0.4), rgba(212,255,0,0.15));
  }
  .sb__preview-btn {
    width: 70px; height: 22px; border-radius: 5px;
    background: linear-gradient(135deg, #D4FF00, #BCFF00);
    margin-top: 10px; box-shadow: 0 2px 12px rgba(212,255,0,0.3);
  }
  .sb__preview-blocks { display: flex; gap: 8px; }
  .sb__preview-block {
    flex: 1; padding: 10px; border-radius: 8px;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);
  }
  .sb__preview-icon {
    width: 18px; height: 18px; border-radius: 5px;
    background: rgba(255,255,255,0.08); margin-bottom: 8px;
  }
  .sb__preview-icon--accent { background: rgba(212,255,0,0.2); }
  .sb__preview-line { width: 100%; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.06); }
  .sb__widgets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 4px; }
  .sb__widget {
    background: rgba(255,255,255,0.03); padding: 12px; border-radius: 6px;
    text-align: center; border: 1px solid rgba(255,255,255,0.05);
  }
  .sb__widget-header { font-size: 10px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
  .sb__widget-value { font-size: 18px; font-weight: 700; color: #dba617; }
  .sb__widget-value--good { color: #28c840; }
  .sb__widget-value--accent { color: var(--color-accent); }
  .sb__widget-label { font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 2px; }

  @media (max-width: 768px) {
    .serenity__title { font-size: var(--text-2xl); }
    .serenity__stage { height: auto; overflow: visible; }
    .serenity__sb {
      position: relative; top: auto; left: auto;
      transform: none; margin: 0 auto;
      width: 90vw;
      max-width: 90vw;
    }
    .sb__body { height: auto; max-height: none; overflow: visible; }
    .sb__main { overflow: visible; }
    .sb__layout { flex-direction: column; }
    .sb__sidebar { width: 100%; padding: 6px 0; overflow: hidden; }
    .sb__nav { flex-direction: row; flex-wrap: wrap; gap: 0; }
    .sb__nav-item { font-size: 10px; padding: 5px 8px; gap: 4px; white-space: nowrap; }
    .sb__topbar { padding: 6px 10px; font-size: 10px; }
    .sb__content { padding: 8px; gap: 6px; overflow: hidden; }
    .sb__notification { font-size: 10px; padding: 6px 8px; overflow: hidden; text-overflow: ellipsis; }
    .sb__widgets { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .sb__widget { padding: 6px; }
    .sb__widget-value { font-size: 13px; }
    .sb__widget-header { font-size: 8px; }
    .sb__widget-label { font-size: 8px; }
    .float__inner { font-size: 11px; padding: 7px 12px; gap: 5px; }
    .float__inner svg { width: 12px; height: 12px; }
    .float--publish { top: 5%; right: 10%; }
    .float--seo { top: 22%; right: 5%; }
    .float--perf { bottom: 20%; right: 10%; }
    .float--ai { top: 2%; left: 10%; }
    .float--check { top: 45%; right: 5%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const letters = document.querySelectorAll('#serenity .serenity__letter');
    const win = document.querySelector('#serenity .serenity__sb') as HTMLElement;
    const floats = document.querySelectorAll<HTMLElement>('#serenity .serenity__stage .float');
    const notifPublish = document.getElementById('sb-notif-publish');
    const notifSeo = document.getElementById('sb-notif-seo');

    if (!win) return;

    const floatArray = Array.from(floats);

    // Title — same animation as chaos, scoped to #serenity
    gsap.to(letters, {
      opacity: 1,
      y: 0,
      duration: 0.4,
      stagger: 0.03,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#serenity',
        start: 'top 80%',
        toggleActions: 'play none none reverse',
      }
    });

    // Main scrub timeline for the Storyblok window
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#serenity',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.3,
      }
    });

    /* PHASE 1: Window fades in */
    tl.to(win, {
      opacity: 1, duration: 0.08, ease: 'power2.out',
    }, 0);

    /* PHASE 2: Success notifications pop */
    tl.to(notifPublish, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.15);

    tl.to(notifSeo, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.22);

    /* PHASE 3: Positive floats pop out one by one */
    tl.to(floatArray[0], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.30);
    tl.to(floatArray[1], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.36);
    tl.to(floatArray[2], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.42);
    tl.to(floatArray[3], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.48);
    tl.to(floatArray[4], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.54);

    /* 3D tilt on mouse — independent from scroll timeline */
    const scene = document.getElementById('serenity-scene') as HTMLElement;
    const stage = document.querySelector('[data-serenity-stage]') as HTMLElement;
    const shine = document.querySelector('#serenity .sb__shine') as HTMLElement;
    const glow = document.querySelector('#serenity .serenity__glow') as HTMLElement;
    const serenityFloats = document.querySelectorAll<HTMLElement>('#serenity .serenity__stage .float');
    if (scene && stage && win) {
      const MAX_TILT = 12;
      const EASE = 0.08;
      let curRx = 0, curRy = 0, tarRx = 0, tarRy = 0;
      let raf: number | null = null;

      const fData = Array.from(serenityFloats).map((el, i) => {
        const depths = [70, 85, 60, 50, 75];
        return { el, depth: depths[i] || 50, cx: 0, cy: 0, tx: 0, ty: 0 };
      });

      function settled() {
        if (Math.abs(tarRx - curRx) > 0.01 || Math.abs(tarRy - curRy) > 0.01) return false;
        for (const f of fData) if (Math.abs(f.tx - f.cx) > 0.01 || Math.abs(f.ty - f.cy) > 0.01) return false;
        return true;
      }

      function tick() {
        curRx += (tarRx - curRx) * EASE;
        curRy += (tarRy - curRy) * EASE;
        stage.style.transform = `rotateX(${curRx}deg) rotateY(${curRy}deg)`;
        for (const f of fData) {
          f.cx += (f.tx - f.cx) * (EASE * 1.2);
          f.cy += (f.ty - f.cy) * (EASE * 1.2);
          f.el.style.transform = `translate3d(${f.cx}px, ${f.cy}px, ${f.depth}px)`;
        }
        if (settled()) { raf = null; return; }
        raf = requestAnimationFrame(tick);
      }

      function startLoop() { if (raf === null) raf = requestAnimationFrame(tick); }

      scene.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = scene.getBoundingClientRect();
        const cDx = Math.max(-1, Math.min(1, (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2)));
        const cDy = Math.max(-1, Math.min(1, (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2)));
        tarRy = cDx * MAX_TILT;
        tarRx = -cDy * MAX_TILT;

        const glowO = 0.5 + Math.abs(cDx * cDy) * 0.5;
        if (shine) shine.style.backgroundPosition = `${200 - cDx * 150}% 0`;
        if (glow) glow.style.opacity = String(glowO);
        win.style.boxShadow = `
          0 0 0 1px rgba(255,255,255,0.05),
          ${-cDx * 8}px ${-cDy * 8 + 12}px 16px rgba(0,0,0,0.4),
          ${-cDx * 12}px ${-cDy * 12 + 18}px 40px rgba(0,0,0,0.3),
          ${-cDx * 20}px ${-cDy * 20}px 80px -20px rgba(212,255,0,${0.1 + glowO * 0.15})
        `;
        for (const f of fData) {
          const factor = f.depth / 60;
          f.tx = cDx * factor * 25;
          f.ty = -cDy * factor * 25;
        }
        startLoop();
      }, { passive: true });

      scene.addEventListener('mouseleave', () => {
        tarRx = 0; tarRy = 0;
        if (shine) shine.style.backgroundPosition = '200% 0';
        if (glow) glow.style.opacity = '0.5';
        win.style.boxShadow = `
          0 0 0 1px rgba(255,255,255,0.05),
          0 4px 16px rgba(0,0,0,0.4),
          0 12px 40px rgba(0,0,0,0.3),
          0 0 80px -20px rgba(212,255,0,0.15)
        `;
        for (const f of fData) { f.tx = 0; f.ty = 0; }
        startLoop();
      }, { passive: true });
    }
  });
</script>
