    .wp__widget-value, .sb__widget-value { font-size: 13px; }
    .wp__widget-header, .sb__widget-header { font-size: 8px; }
    .wp__widget-label, .sb__widget-label { font-size: 8px; }
    .float__inner { font-size: 12px; padding: 8px 14px; gap: 5px; }
    .float__inner svg { width: 12px; height: 12px; }
    .float--cost .float__inner { font-size: 13px; }
    .float--warning { top: 5%; right: 10%; }
    .float--error { top: 30%; right: 5%; }
    .float--perf { bottom: 20%; right: 10%; }
    .float--plugins { bottom: 8%; left: 15%; }
    .float--cost { top: 25%; left: 10%; }
    .float--sb-publish { top: 5%; right: 10%; }
    .float--sb-seo { top: 22%; right: 5%; }
    .float--sb-perf { bottom: 20%; right: 10%; }
    .float--sb-ai { top: 2%; left: 10%; }
    .float--sb-check { top: 45%; right: 5%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const chaosTitle = document.querySelector('#chaos-serenite [data-chaos-title]') as HTMLElement;
    const serenityTitle = document.querySelector('#chaos-serenite [data-serenity-title]') as HTMLElement;
    const lettersA = document.querySelectorAll('#chaos-serenite [data-chaos-title] .duo__letter');
    const lettersB = document.querySelectorAll('#chaos-serenite [data-serenity-title] .duo__letter');
    const winWP = document.querySelector('[data-duo-wp]') as HTMLElement;
    const winSB = document.querySelector('[data-duo-sb]') as HTMLElement;
    const wpFloats = Array.from(document.querySelectorAll<HTMLElement>('#chaos-serenite [data-wp-float]'));
    const sbFloats = Array.from(document.querySelectorAll<HTMLElement>('#chaos-serenite [data-sb-float]'));
    const notifUpdate = document.getElementById('notif-update');
    const notifSecurity = document.getElementById('notif-security');
    const notifPlugin = document.getElementById('notif-plugin');
    const notifPublish = document.getElementById('sb-notif-publish');
    const notifSeo = document.getElementById('sb-notif-seo');
    const wpPerf = document.getElementById('wp-perf');
    const wpSecu = document.getElementById('wp-secu');
    const wpCost = document.getElementById('wp-cost');
    const pluginBadge = document.getElementById('wp-plugin-count');
    const floatPerf = document.getElementById('float-perf');
    const floatPlugins = document.getElementById('float-plugins');
    const floatCost = document.getElementById('float-cost');

    if (!winWP || !winSB) return;

    const proxy = { pluginCount: 1, perfVal: 74, costVal: 240 };

    // One scrub timeline for the whole sequence
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#chaos-serenite',
        start: 'top 90%',
        end: 'bottom bottom',
        scrub: 0.3,
      }
    });

    /* ENTRANCE: chaos title + WP window fade in together */
    tl.fromTo(lettersA,
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.002, duration: 0.04, ease: 'power2.out' },
      0);
    tl.fromTo(winWP,
      { opacity: 0 },
      { opacity: 1, duration: 0.03, ease: 'power2.out' },
      0);

    /* WP ACT: plugins increase + notifications (unchanged choreography) */
    const pluginSteps = [
      { pos: 0.08, count: 1, color: '#28c840' },
      { pos: 0.11, count: 3, color: '#28c840' },
      { pos: 0.14, count: 5, color: '#28c840' },
      { pos: 0.17, count: 7, color: '#dba617' },
      { pos: 0.20, count: 9, color: '#dba617' },
      { pos: 0.23, count: 11, color: '#FF3333' },
      { pos: 0.26, count: 12, color: '#FF3333' },
    ];

    pluginSteps.forEach((step) => {
      tl.to(proxy, {
        pluginCount: step.count,
        duration: 0.001,
        onUpdate: () => {
          if (pluginBadge) {
            pluginBadge.textContent = String(step.count);
            pluginBadge.style.background = step.color;
          }
          if (floatPlugins) floatPlugins.textContent = String(step.count);
        }
      }, step.pos);
    });

    tl.to(notifUpdate, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.12);

    tl.to(notifSecurity, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.16);

    tl.to(notifPlugin, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.20);

    /* WP ACT: values degrade */
    const perfSteps = [
      { pos: 0.28, val: 74, cls: 'wp__widget-value--orange' },
      { pos: 0.32, val: 65, cls: 'wp__widget-value--orange' },
      { pos: 0.36, val: 55, cls: 'wp__widget-value--orange' },
      { pos: 0.40, val: 45, cls: 'wp__widget-value--bad' },
      { pos: 0.44, val: 35, cls: 'wp__widget-value--bad' },
      { pos: 0.48, val: 28, cls: 'wp__widget-value--bad' },
      { pos: 0.52, val: 22, cls: 'wp__widget-value--bad' },
    ];

    perfSteps.forEach((step) => {
      tl.to(proxy, {
        perfVal: step.val,
        duration: 0.001,
        onUpdate: () => {
          if (wpPerf) {
            wpPerf.textContent = String(step.val);
            wpPerf.className = 'wp__widget-value ' + step.cls;
          }
          if (floatPerf) floatPerf.textContent = String(step.val);
        }
      }, step.pos);
    });

    const secuSteps = [
      { pos: 0.29, text: 'BON', cls: 'wp__widget-value--good' },
      { pos: 0.33, text: '1 faille', cls: 'wp__widget-value--orange' },
      { pos: 0.37, text: '2 failles', cls: 'wp__widget-value--orange' },
      { pos: 0.41, text: '3 failles', cls: 'wp__widget-value--orange' },
      { pos: 0.45, text: '5 failles', cls: 'wp__widget-value--bad' },
      { pos: 0.49, text: '7 failles', cls: 'wp__widget-value--bad' },
      { pos: 0.53, text: '10 failles', cls: 'wp__widget-value--bad' },
      { pos: 0.57, text: '14 failles', cls: 'wp__widget-value--bad' },
    ];

    secuSteps.forEach((step) => {
      tl.to(proxy, {
        duration: 0.001,
        onUpdate: () => {
          if (wpSecu) {
            wpSecu.textContent = step.text;
            wpSecu.className = 'wp__widget-value ' + step.cls;
          }
        }
      }, step.pos);
    });

    const costSteps = [
      { pos: 0.30, val: 240 },
      { pos: 0.34, val: 350 },
      { pos: 0.38, val: 500 },
      { pos: 0.43, val: 700 },
      { pos: 0.48, val: 900 },
      { pos: 0.53, val: 1100 },
      { pos: 0.57, val: 1250 },
    ];

    costSteps.forEach((step) => {
      tl.to(proxy, {
        costVal: step.val,
        duration: 0.001,
        onUpdate: () => {
          if (wpCost) wpCost.textContent = step.val + '\u20AC/an';
          if (floatCost) floatCost.textContent = String(step.val);
        }
      }, step.pos);
    });

    /* WP ACT: floats pop out one by one */
    tl.to(wpFloats[4], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.45);
    tl.to(wpFloats[0], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.50);
    tl.to(wpFloats[2], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.55);
    tl.to(wpFloats[1], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.60);
    tl.to(wpFloats[3], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.65);

    /* MORPH (0.68 - 0.78): chaos title + WP scene out, serenity title in.
       "Passez du chaos..." is fully gone afterwards. */
    tl.to(lettersA, {
      opacity: 0, y: -24, stagger: 0.002, duration: 0.05, ease: 'power2.in',
    }, 0.68);
    tl.fromTo(winWP, { opacity: 1 }, { opacity: 0, duration: 0.06, ease: 'power2.in' }, 0.68);
    tl.to(wpFloats, { opacity: 0, duration: 0.05, ease: 'power2.in' }, 0.68);
    tl.set(chaosTitle, { display: 'none' }, 0.73);
    tl.set(serenityTitle, { display: 'flex' }, 0.73);
    tl.fromTo(lettersB,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, stagger: 0.002, duration: 0.05, ease: 'power2.out' },
      0.73);

    /* SERENITY ACT: window fades in right as the morph completes */
    tl.fromTo(winSB, { opacity: 0 }, { opacity: 1, duration: 0.04, ease: 'power2.out' }, 0.78);

    tl.to(notifPublish, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.82);

    tl.to(notifSeo, {
      opacity: 1, y: 0, duration: 0.03, ease: 'power2.out',
    }, 0.86);

    tl.to(sbFloats[0], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.86);
    tl.to(sbFloats[1], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.88);
    tl.to(sbFloats[2], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.90);
    tl.to(sbFloats[3], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.92);
    tl.to(sbFloats[4], { opacity: 1, duration: 0.06, ease: 'power2.out' }, 0.94);

    /* 3D tilt on mouse — independent from scroll timeline */
    const scene = document.getElementById('duo-scene') as HTMLElement;
    const stage = document.querySelector('[data-duo-stage]') as HTMLElement;
    const shineWP = document.querySelector('.duo__wp .wp__shine') as HTMLElement;
    const shineSB = document.querySelector('.duo__sb .sb__shine') as HTMLElement;
    const glow = document.querySelector('.duo__glow') as HTMLElement;
    const allFloats = document.querySelectorAll<HTMLElement>('#chaos-serenite .duo__stage .float');
    if (scene && stage && winWP && winSB) {
      const MAX_TILT = 12;
      const EASE = 0.08;
      let curRx = 0, curRy = 0, tarRx = 0, tarRy = 0;
      let raf: number | null = null;

      const fData = Array.from(allFloats).map((el, i) => {
        const depths = [70, 85, 60, 50, 75, 70, 85, 60, 50, 75];
        return { el, depth: depths[i] || 50, cx: 0, cy: 0, tx: 0, ty: 0 };
      });

      function settled() {
        if (Math.abs(tarRx - curRx) > 0.01 || Math.abs(tarRy - curRy) > 0.01) return false;
        for (const f of fData) if (Math.abs(f.tx - f.cx) > 0.01 || Math.abs(f.ty - f.cy) > 0.01) return false;
        return true;
      }

      function tick() {
        curRx += (tarRx - curRx) * EASE;
        curRy += (tarRy - curRy) * EASE;
        stage.style.transform = `rotateX(${curRx}deg) rotateY(${curRy}deg)`;
        for (const f of fData) {
          f.cx += (f.tx - f.cx) * (EASE * 1.2);
          f.cy += (f.ty - f.cy) * (EASE * 1.2);
          f.el.style.transform = `translate3d(${f.cx}px, ${f.cy}px, ${f.depth}px)`;
        }
        if (settled()) { raf = null; return; }
        raf = requestAnimationFrame(tick);
      }

      function startLoop() { if (raf === null) raf = requestAnimationFrame(tick); }

      function paintShadows(cDx: number, cDy: number, glowO: number) {
        const shadow = `
          0 0 0 1px rgba(255,255,255,0.05),
          ${-cDx * 8}px ${-cDy * 8 + 12}px 16px rgba(0,0,0,0.4),
          ${-cDx * 12}px ${-cDy * 12 + 18}px 40px rgba(0,0,0,0.3),
          ${-cDx * 20}px ${-cDy * 20}px 80px -20px rgba(212,255,0,${0.1 + glowO * 0.15})
        `;
        winWP.style.boxShadow = shadow;
        winSB.style.boxShadow = shadow;
      }

      scene.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = scene.getBoundingClientRect();
        const cDx = Math.max(-1, Math.min(1, (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2)));
        const cDy = Math.max(-1, Math.min(1, (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2)));
        tarRy = cDx * MAX_TILT;
        tarRx = -cDy * MAX_TILT;

        const glowO = 0.5 + Math.abs(cDx * cDy) * 0.5;
        if (shineWP) shineWP.style.backgroundPosition = `${200 - cDx * 150}% 0`;
        if (shineSB) shineSB.style.backgroundPosition = `${200 - cDx * 150}% 0`;
        if (glow) glow.style.opacity = String(glowO);
        paintShadows(cDx, cDy, glowO);
        for (const f of fData) {
          const factor = f.depth / 60;
          f.tx = cDx * factor * 25;
          f.ty = -cDy * factor * 25;
        }
        startLoop();
      }, { passive: true });

      scene.addEventListener('mouseleave', () => {
        tarRx = 0; tarRy = 0;
        if (shineWP) shineWP.style.backgroundPosition = '200% 0';
        if (shineSB) shineSB.style.backgroundPosition = '200% 0';
        if (glow) glow.style.opacity = '0.5';
        paintShadows(0, 0, 0.5);
        for (const f of fData) { f.tx = 0; f.ty = 0; }
        startLoop();
      }, { passive: true });
    }
  });
</script>
