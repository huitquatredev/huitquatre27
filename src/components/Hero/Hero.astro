---
// Hero — bold two-beat type, CTAs, and a count-up proof strip.
// The animation IS the argument: measurable proof before promise.
const stats = [
  { value: 92, prefix: "−", suffix: " %", label: "de poids en moins vs la page médiane" },
  { value: 100, prefix: "", suffix: "", label: "score PageSpeed visé sur mobile" },
  { value: 1990, prefix: "", suffix: " €", label: "payé une fois, zéro abonnement", money: true },
  { value: 30, prefix: "", suffix: " j", label: "du brief à la mise en ligne" },
];
---

<section class="hero">
  <div class="container">
    <p class="hero__eyebrow">Agence web (im)pertinente — Piolenc, Vaucluse</p>
    <h1 class="hero__title">
      <span class="hero__line">Votre site web.</span>
      <span class="hero__line hero__line--accent">L'esprit tranquille.</span>
    </h1>

    <p class="hero__subtitle">
      Site sur-mesure, payé une fois. Léger, rapide, sans abonnement —
      la preuve avant la promesse, chiffres ci-dessous.
    </p>

    <div class="hero__cta">
      <a href="/contact" class="btn">
        <span class="btn__icon-wrap is--default">
          <span class="btn__icon-bg"></span>
          <svg
            class="btn__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><path
              d="M14 19L21 12L14 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path><path
              d="M21 12H2"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path></svg
          >
        </span>
        <span class="btn__text-wrap">
          <span class="btn__text">Démarrer mon projet</span>
        </span>
        <span class="btn__icon-wrap is--hover">
          <span class="btn__icon-bg"></span>
          <svg
            class="btn__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><path
              d="M14 19L21 12L14 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path><path
              d="M21 12H2"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path></svg
          >
        </span>
      </a>
      <a href="/realisations" class="btn" data-btn-theme="secondary">
        <span class="btn__icon-wrap is--default">
          <span class="btn__icon-bg"></span>
          <svg
            class="btn__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><path
              d="M14 19L21 12L14 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path><path
              d="M21 12H2"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path></svg
          >
        </span>
        <span class="btn__text-wrap">
          <span class="btn__text">Notre portfolio</span>
        </span>
        <span class="btn__icon-wrap is--hover">
          <span class="btn__icon-bg"></span>
          <svg
            class="btn__icon"
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            ><path
              d="M14 19L21 12L14 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path><path
              d="M21 12H2"
              stroke="currentColor"
              stroke-width="2"
              stroke-miterlimit="10"></path></svg
          >
        </span>
      </a>
    </div>

    <dl class="hero__proof" data-proof>
      {stats.map((s, i) => (
        <div class="hero__stat">
          <dt class="hero__value" data-count={s.value} data-prefix={s.prefix} data-suffix={s.suffix} data-money={s.money ? "1" : "0"} style={`--d:${i * 120}ms`}>0</dt>
          <dd class="hero__label">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-secondary);
    padding: var(--space-3xl) 0 var(--space-2xl);
  }
  .hero .container {
    max-width: var(--container-max);
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-neutral);
    margin-bottom: var(--space-md);
  }
  .hero__title {
    font-size: clamp(2.75rem, 1.5rem + 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    max-width: 12ch;
  }
  .hero__line { display: block; }
  .hero__line--accent { color: var(--color-accent-ink); }
  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-neutral);
    max-width: 560px;
    margin-top: var(--space-lg);
  }
  .hero__cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }
  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin: var(--space-2xl) 0 0;
    padding: 0;
  }
  .hero__stat {
    border-top: 2px solid var(--color-primary);
    padding-top: var(--space-sm);
  }
  .hero__value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .hero__label {
    font-size: var(--text-sm);
    color: var(--color-neutral);
    margin-top: 4px;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .hero__proof { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const proof = document.querySelector("[data-proof]") as HTMLElement | null;
    if (!proof) return;
    const values = Array.from(proof.querySelectorAll<HTMLElement>("[data-count]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fmt = (v: number, money: boolean) =>
      money ? v.toLocaleString("fr-FR").replace(/[\u202F\u00A0]/g, " ") : String(v);
    const render = (el: HTMLElement, v: number) => {
      el.textContent = (el.dataset.prefix || "") + fmt(v, el.dataset.money === "1") + (el.dataset.suffix || "");
    };
    if (reduceMotion) {
      values.forEach((el) => render(el, Number(el.dataset.count || 0)));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.disconnect();
        values.forEach((el) => {
          const target = Number(el.dataset.count || 0);
          const delay = Number((el.style.getPropertyValue("--d") || "0ms").replace("ms", ""));
          const t0 = performance.now() + delay;
          const tick = (now: number) => {
            const p = Math.min(1, Math.max(0, (now - t0) / 1100));
            render(el, Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }
    }, { threshold: 0.3 });
    io.observe(proof);
  });
</script>
