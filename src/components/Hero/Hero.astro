---
import Button from "../Button/Button.astro";
// Hero — Franco-style: full-bleed countryside video, giant lin type.
// Same copy, same button system, no video card.
---

<section class="hero">
  <video
    class="hero__video"
    data-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="https://images.pexels.com/videos/26655205/beautiful-breeze-bugs-countryside-26655205.jpeg?auto=compress&cs=tinysrgb&w=1260"
  >
    <source src="https://videos.pexels.com/video-files/26655205/11985471_1280_720_60fps.mp4" type="video/mp4" />
  </video>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__labels">
      <span>Sites écologiques &amp; singuliers</span>
      <span>Depuis Piolenc, Vaucluse</span>
    </div>

    <h1 class="hero__title">
      <span class="hero__line">Votre site web.</span>
      <span class="hero__line">L'esprit tranquille.</span>
    </h1>

    <div class="hero__foot">
      <div class="hero__actions">
      <div class="hero__cta">
        <Button href="/contact" theme="secondary">Démarrer mon projet</Button>
        <Button href="/realisations">Notre portfolio</Button>
      </div>

      <p class="hero__subtitle">
        huitquatre crée, héberge et maintient votre site.
        Vous, vous profitez. Pas de frais récurrents.
      </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background-color: var(--color-accent);
    color: var(--color-secondary);
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero__video.is-ready { opacity: 1; }
  .hero__scrim {
    --scrim-55: color-mix(in srgb, var(--color-primary) 55%, transparent);
    --scrim-25: color-mix(in srgb, var(--color-primary) 25%, transparent);
    --scrim-50: color-mix(in srgb, var(--color-primary) 50%, transparent);
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--scrim-55) 0%, var(--scrim-25) 45%, transparent 70%),
      linear-gradient(to top, var(--scrim-50), transparent 30%);
  }
  .hero__inner {
    position: relative;
    width: 100%;
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: var(--space-xl);
  }
  .hero__labels {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    opacity: 0.85;
    margin-bottom: var(--space-sm);
  }
  .hero__title {
    font-size: clamp(2.5rem, 9vw, 9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .hero__line { display: block; }
  .hero__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-md);
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: fit-content;
    max-width: 100%;
  }
  .hero__subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background: transparent;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    padding: 10px 16px;
    max-width: 53ch;
    text-align: left;
  }
  .hero__cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  /* Secondary on image: opaque wine pill, lin text */
  .hero :global(.btn[data-btn-theme="secondary"]) {
    --btn-color: var(--color-secondary);
  }
  .hero :global(.btn[data-btn-theme="secondary"] .btn__text-wrap),
  .hero :global(.btn[data-btn-theme="secondary"] .btn__icon-bg) {
    background-color: var(--color-wine);
    border: 1px solid var(--color-wine);
  }
  .hero__cta :global(.btn:last-child) {
    --btn-color-background: var(--color-accent-ink);
  }

  @media (max-width: 768px) {
    .hero__title { font-size: clamp(2.75rem, 15vw, 5rem); }
    .hero__labels { flex-direction: column; gap: 2px; font-size: var(--text-xs); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video { transition: none; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.querySelector("[data-hero-video]") as HTMLVideoElement | null;
    if (!video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
      return;
    }
    const ready = () => video.classList.add("is-ready");
    if (video.readyState >= 3) ready();
    else video.addEventListener("canplay", ready, { once: true });
    video.play().catch(() => {});
  });
</script>
