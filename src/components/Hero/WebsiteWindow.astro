---
// WebsiteWindow — 3D perspective hover with floating UI elements
---

<div class="scene">
  <div class="scene__glow"></div>

  <div class="scene__stage" data-stage>

    <!-- Floating elements — different Z depths -->
    <div class="float float--publish" data-float="80">
      <div class="float__inner">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 14L14 2M14 2H6M14 2v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Publier
      </div>
    </div>

    <div class="float float--page" data-float="50">
      <div class="float__inner">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="2" y="1" width="12" height="14" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 5h6M5 8h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Nouvelle page
      </div>
    </div>

    <div class="float float--colors" data-float="65">
      <div class="float__inner">
        <div class="float__colors">
          <span class="float__dot" style="background:#D4FF00"></span>
          <span class="float__dot" style="background:#FFFFFF"></span>
          <span class="float__dot" style="background:#777777"></span>
        </div>
        Palette
      </div>
    </div>

    <div class="float float--seo" data-float="70">
      <div class="float__inner">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.3"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        SEO
        <span class="float__badge">100</span>
      </div>
    </div>

    <div class="float float--speed" data-float="55">
      <div class="float__inner">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M9 1L3 9h4l-1 6 6-8H8l1-6z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Perf
        <span class="float__badge">100</span>
      </div>
    </div>

    <div class="float float--media" data-float="40">
      <div class="float__inner">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="2" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/><circle cx="5" cy="6" r="1.5" fill="currentColor"/><path d="M1 11l4-3 3 2 3-4 4 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    <div class="float float--check" data-float="90">
      <div class="float__inner float__inner--icon">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.3"/><path d="M6 10l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    <div class="float float--ai" data-float="45">
      <div class="float__inner float__inner--icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>
      </div>
    </div>

    <!-- The browser window — sits at Z 0 -->
    <div class="window" data-tilt>
      <div class="window__shine"></div>
      <div class="window__chrome">
        <div class="window__dots">
          <span></span><span></span><span></span>
        </div>
        <div class="window__address">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1a5 5 0 0 0-5 5v1a5 5 0 0 0 10 0V6a5 5 0 0 0-5-5Z" stroke="currentColor" stroke-width="1.2"/><rect x="6" y="6" width="4" height="3" rx="1" fill="currentColor" opacity=".4"/></svg>
          <span>huitquatre.fr</span>
        </div>
      </div>
      <div class="window__page">
        <div class="page__nav">
          <div class="page__nav-logo"></div>
          <div class="page__nav-links">
            <div class="page__nav-link"></div>
            <div class="page__nav-link"></div>
            <div class="page__nav-link page__nav-link--accent"></div>
          </div>
        </div>
        <div class="page__hero">
          <div class="page__hero-title"></div>
          <div class="page__hero-title page__hero-title--short"></div>
          <div class="page__hero-sub"></div>
          <div class="page__hero-sub page__hero-sub--short"></div>
          <div class="page__hero-btn"></div>
        </div>
        <div class="page__cards">
          <div class="page__card">
            <div class="page__card-icon"></div>
            <div class="page__card-line"></div>
            <div class="page__card-line page__card-line--short"></div>
          </div>
          <div class="page__card">
            <div class="page__card-icon page__card-icon--accent"></div>
            <div class="page__card-line"></div>
            <div class="page__card-line page__card-line--short"></div>
          </div>
          <div class="page__card">
            <div class="page__card-icon"></div>
            <div class="page__card-line"></div>
            <div class="page__card-line page__card-line--short"></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Scene ── */
  .scene {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 900px;
    perspective-origin: 50% 50%;
  }

  .scene__glow {
    position: absolute;
    width: 60%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(212, 255, 0, 0.18) 0%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
    transition: opacity 0.5s ease;
    z-index: 0;
  }

  .scene__stage {
    position: relative;
    width: 380px;
    height: 340px;
    transform-style: preserve-3d;
    z-index: 1;
  }

  /* ── Floating elements ── */
  .float {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: none;
    z-index: 2;
  }

  .float__inner {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgba(26, 26, 26, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      0 0 40px -10px rgba(212, 255, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .float__inner--icon {
    padding: 10px;
    border-radius: 12px;
  }

  .float__inner svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .float__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(72, 199, 100, 0.2);
    color: #48c764;
    font-size: 11px;
    font-weight: 700;
  }

  .float__unit {
    font-size: 10px;
    opacity: 0.5;
  }

  .float__colors {
    display: flex;
    gap: 4px;
  }

  .float__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
  }

  /* ── Float positions ── */
  .float--publish {
    top: -8px;
    right: -10px;
  }

  .float--page {
    top: 40%;
    left: -24px;
  }

  .float--colors {
    bottom: 18%;
    left: -16px;
  }

  .float--seo {
    top: 12%;
    right: -20px;
  }

  .float--speed {
    bottom: -4px;
    right: 10%;
  }

  .float--media {
    bottom: 42%;
    right: -32px;
  }

  .float--check {
    top: 65%;
    right: -18px;
  }

  .float--ai {
    top: -6px;
    left: 10%;
  }

  /* ── Window (same as before) ── */
  .window {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    border-radius: 12px;
    overflow: hidden;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 12px 40px rgba(0, 0, 0, 0.3),
      0 0 80px -20px rgba(212, 255, 0, 0.15);
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease;
    z-index: 1;
  }

  .window__shine {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.04) 45%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(255, 255, 255, 0.04) 55%,
      transparent 60%
    );
    background-size: 250% 100%;
    background-position: 200% 0;
    border-radius: 12px;
  }

  .window__chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window__dots {
    display: flex;
    gap: 5px;
  }

  .window__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .window__dots span:nth-child(1) { background: #ff5f57; }
  .window__dots span:nth-child(2) { background: #febc2e; }
  .window__dots span:nth-child(3) { background: #28c840; }

  .window__address {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.3);
    font-size: 11px;
    font-family: var(--font-body);
  }

  /* Mini page content */
  .page__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .page__nav-logo {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: linear-gradient(135deg, #D4FF00, #BCFF00);
  }

  .page__nav-links {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .page__nav-link {
    width: 32px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.1);
  }

  .page__nav-link--accent {
    width: 40px;
    height: 20px;
    border-radius: 4px;
    background: rgba(212, 255, 0, 0.25);
    border: 1px solid rgba(212, 255, 0, 0.3);
  }

  .page__hero {
    padding: 24px 16px 20px;
  }

  .page__hero-title {
    width: 80%;
    height: 10px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.15);
    margin-bottom: 6px;
  }

  .page__hero-title--short {
    width: 55%;
    background: linear-gradient(90deg, rgba(212, 255, 0, 0.4), rgba(212, 255, 0, 0.15));
  }

  .page__hero-sub {
    width: 90%;
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    margin-top: 10px;
    margin-bottom: 4px;
  }

  .page__hero-sub--short { width: 65%; }

  .page__hero-btn {
    width: 70px;
    height: 22px;
    border-radius: 5px;
    background: linear-gradient(135deg, #D4FF00, #BCFF00);
    margin-top: 14px;
    box-shadow: 0 2px 12px rgba(212, 255, 0, 0.3);
  }

  .page__cards {
    display: flex;
    gap: 8px;
    padding: 0 16px 16px;
  }

  .page__card {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .page__card-icon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
  }

  .page__card-icon--accent {
    background: rgba(212, 255, 0, 0.2);
  }

  .page__card-line {
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.06);
    margin-bottom: 4px;
  }

  .page__card-line--short { width: 60%; }

  @media (max-width: 768px) {
    .scene__stage { width: 280px; height: 250px; }
    .window { width: 280px; }
  }
</style>

<script>
  function init() {
    const scene = document.querySelector(".scene") as HTMLElement
    const stage = document.querySelector("[data-stage]") as HTMLElement
    const win = document.querySelector("[data-tilt]") as HTMLElement
    const shine = document.querySelector(".window__shine") as HTMLElement
    const glow = document.querySelector(".scene__glow") as HTMLElement
    const floats = document.querySelectorAll<HTMLElement>("[data-float]")
    if (!scene || !stage || !win) return

    const MAX_TILT = 18
    const EASE = 0.08
    let currentRx = 0
    let currentRy = 0
    let targetRx = 0
    let targetRy = 0
    let raf: number | null = null

    const floatData = Array.from(floats).map((el) => {
      const depth = parseFloat(el.dataset.float || "50")
      return { el, depth, currentX: 0, currentY: 0, targetX: 0, targetY: 0 }
    })

    function isSettled() {
      if (Math.abs(targetRx - currentRx) > 0.01 || Math.abs(targetRy - currentRy) > 0.01) return false
      for (const f of floatData) {
        if (Math.abs(f.targetX - f.currentX) > 0.01 || Math.abs(f.targetY - f.currentY) > 0.01) return false
      }
      return true
    }

    function tick() {
      currentRx += (targetRx - currentRx) * EASE
      currentRy += (targetRy - currentRy) * EASE

      stage.style.transform = `rotateX(${currentRx}deg) rotateY(${currentRy}deg)`

      for (const f of floatData) {
        f.currentX += (f.targetX - f.currentX) * (EASE * 1.2)
        f.currentY += (f.targetY - f.currentY) * (EASE * 1.2)
        f.el.style.transform = `translate3d(${f.currentX}px, ${f.currentY}px, ${f.depth}px)`
      }

      if (isSettled()) {
        raf = null
        return
      }
      raf = requestAnimationFrame(tick)
    }

    function startLoop() {
      if (raf === null) raf = requestAnimationFrame(tick)
    }

    function onMove(e: MouseEvent) {
      const rect = scene.getBoundingClientRect()
      const cx = rect.left + rect.width / 2
      const cy = rect.top + rect.height / 2

      const cDx = Math.max(-1, Math.min(1, (e.clientX - cx) / (rect.width / 2)))
      const cDy = Math.max(-1, Math.min(1, (e.clientY - cy) / (rect.height / 2)))

      targetRy = cDx * MAX_TILT
      targetRx = -cDy * MAX_TILT

      const glowO = 0.5 + Math.abs(cDx * cDy) * 0.5
      shine.style.backgroundPosition = `${200 - cDx * 150}% 0`
      glow.style.opacity = String(glowO)
      win.style.boxShadow = `
        0 0 0 1px rgba(255,255,255,0.05),
        ${-cDx * 8}px ${-cDy * 8 + 12}px 16px rgba(0,0,0,0.4),
        ${-cDx * 12}px ${-cDy * 12 + 18}px 40px rgba(0,0,0,0.3),
        ${-cDx * 20}px ${-cDy * 20}px 80px -20px rgba(212,255,0,${0.1 + glowO * 0.15})
      `

      for (const f of floatData) {
        const factor = f.depth / 60
        f.targetX = cDx * factor * 25
        f.targetY = -cDy * factor * 25
      }

      startLoop()
    }

    function onLeave() {
      targetRx = 0
      targetRy = 0
      shine.style.backgroundPosition = "200% 0"
      glow.style.opacity = "0.5"
      win.style.boxShadow = `
        0 0 0 1px rgba(255,255,255,0.05),
        0 4px 16px rgba(0,0,0,0.4),
        0 12px 40px rgba(0,0,0,0.3),
        0 0 80px -20px rgba(212,255,0,0.15)
      `
      for (const f of floatData) {
        f.targetX = 0
        f.targetY = 0
      }
      startLoop()
    }

    scene.addEventListener("mousemove", onMove, { passive: true })
    scene.addEventListener("mouseleave", onLeave, { passive: true })
  }

  document.addEventListener("DOMContentLoaded", init)
</script>
