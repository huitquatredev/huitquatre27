---

---

<div data-transition-wrap class="transition" aria-hidden="true">
  <div class="transition__panels">
    <div data-transition-panel="1" class="transition__panel-1"></div>
    <div data-transition-panel="2" class="transition__panel-2"></div>
  </div>
</div>

<script is:inline>
  // Watchdog: never trap the visitor if the animation bundle fails.
  window.__hqLoaderDone = false
  setTimeout(function () {
    if (!window.__hqLoaderDone) {
      var wrap = document.querySelector("[data-transition-wrap]")
      if (wrap) wrap.style.display = "none"
      document.documentElement.classList.remove("hq-wipe-go")
      document.body.style.overflow = ""
    }
  }, 6000)
</script>

<style is:global>
  /* is:global — le wrap est fixé et piloté par une classe sur <html>,
     posée avant le premier paint (voir Layout). */
  .transition {
    z-index: 300;
    pointer-events: none;
    position: fixed;
    inset: 0;
    overflow: clip;
    display: none;
  }

  .transition.is-live,
  html.hq-wipe-go .transition {
    display: block;
  }

  .transition__panels {
    width: 100%;
    height: 100%;
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
  }

  .transition__panel-1 {
    background-color: var(--color-argile);
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    will-change: transform;
  }

  .transition__panel-2 {
    background-color: var(--color-primary);
    background-image: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-primary) 82%, var(--color-argile)),
      var(--color-primary)
    );
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    will-change: transform;
  }
</style>

<script>
  import { gsap } from "gsap"

  document.addEventListener("DOMContentLoaded", () => {
    const wrap = document.querySelector(
      "[data-transition-wrap]"
    ) as HTMLElement | null
    if (!wrap) return
    const panel1 = wrap.querySelector(
      "[data-transition-panel='1']"
    ) as HTMLElement
    const panel2 = wrap.querySelector(
      "[data-transition-panel='2']"
    ) as HTMLElement

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches
    if ("scrollRestoration" in history) history.scrollRestoration = "manual"

    const KEY = "hq-wipe-go"
    const readFlag = () => {
      try {
        return window.sessionStorage.getItem(KEY) === "1"
      } catch {
        return false
      }
    }
    const writeFlag = (on: boolean) => {
      try {
        if (on) window.sessionStorage.setItem(KEY, "1")
        else window.sessionStorage.removeItem(KEY)
      } catch {
        /* private mode */
      }
    }

    function finish() {
      wrap.classList.remove("is-live")
      document.documentElement.classList.remove("hq-wipe-go")
      document.body.style.overflow = ""
      gsap.set([panel1, panel2], { clearProps: "transform" })
      writeFlag(false)
      ;(window as any).__hqLoaderDone = true
      window.dispatchEvent(new Event("loaderComplete"))
    }

    /* ——— Arrivée : le cover est déjà posé (top: 0) dès le premier paint ——— */
    if (readFlag() && !reduceMotion) {
      document.body.style.overflow = "hidden"
      const tl = gsap.timeline({ onComplete: finish })
      tl.add("startEnter", 0.1)
      tl.set(panel1, { yPercent: -100 }, "startEnter")
      tl.to(
        panel2,
        { yPercent: -100, duration: 1.2, ease: "power4.out" },
        "startEnter"
      )
    } else {
      finish()
    }

    /* ——— Départ : deux panneaux montent, puis navigation ——— */
    let covering = false
    function coverAndGo(href: string) {
      if (covering) return
      covering = true
      if (reduceMotion) {
        window.location.href = href
        return
      }
      gsap.set([panel1, panel2], { yPercent: 100 })
      wrap.classList.add("is-live")
      document.body.style.overflow = "hidden"

      const tl = gsap.timeline({
        onComplete: () => {
          writeFlag(true)
          window.location.href = href
        }
      })

      tl.to(panel1, { yPercent: 0, duration: 0.6, ease: "power4.in" }, 0)
      tl.to(panel2, { yPercent: 0, duration: 0.6, ease: "power4.in" }, 0.25)
    }

    /* ——— bfcache : la page revient dans son état de départ (cover posé) ——— */
    window.addEventListener("pageshow", (e) => {
      if (!e.persisted) return
      covering = false
      finish()
    })

    /* ——— Intercept internal navigations ——— */
    document.addEventListener("click", (e: MouseEvent) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
        return
      const anchor = (e.target as HTMLElement).closest?.(
        "a[href]"
      ) as HTMLAnchorElement | null
      if (!anchor) return
      if (anchor.target === "_blank" || anchor.hasAttribute("download")) return
      const url = new URL(anchor.href, window.location.href)
      if (url.origin !== window.location.origin) return
      // Same-page anchors: let the browser scroll
      if (url.pathname === window.location.pathname && url.hash) return
      e.preventDefault()
      coverAndGo(url.href)
    })
  })
</script>
