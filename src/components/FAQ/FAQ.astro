---
import type { FaqItem } from "../../data/faq";

interface Props {
  items: FaqItem[];
  eyebrow?: string;
  titleA?: string;
  titleB?: string;
  more?: string;
  sectionId?: string;
}

const {
  items,
  eyebrow = "FAQ",
  titleA = "Questions ?",
  titleB = "Réponses.",
  more,
  sectionId = "faq",
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a.replace(/<[^>]*>/g, "") },
  })),
};
---

<section class="faq" id={sectionId}>
  <div class="faq__header">
    <p class="faq__eyebrow">{eyebrow}</p>
    <h2 class="faq__title">{titleA} <span class="faq__accent">{titleB}</span></h2>
  </div>

  <div class="faq__list" data-faq-list>
    {items.map((item) => (
      <details class="faq__item" data-reveal>
        <summary class="faq__question">
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
        </summary>
        <div class="faq__answer"><div><p set:html={item.a}></p></div></div>
      </details>
    ))}
  </div>

  {more && (
    <div class="faq__more">
      <a href={more}>Toutes les questions →</a>
    </div>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq {
    background-color: var(--color-secondary);
    padding: var(--space-3xl) var(--container-padding);
  }
  .faq__header { max-width: var(--container-max); margin: 0 auto var(--space-xl); }
  .faq__eyebrow {
    font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-neutral); margin-bottom: var(--space-sm);
  }
  .faq__title {
    color: var(--color-primary); font-size: var(--text-4xl);
    text-transform: uppercase; letter-spacing: -0.03em; line-height: 1.05;
  }
  .faq__accent { color: var(--color-argile); }

  .faq__list { max-width: var(--container-max); margin: 0 auto; }
  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }
  .faq__question {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md); padding: var(--space-md) var(--space-sm);
    font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700;
    color: var(--color-primary);
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: var(--color-accent-ink); }
  .faq__icon {
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform var(--transition-base), background-color var(--transition-base), color var(--transition-base);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background-color: var(--color-accent); color: var(--color-secondary); border-color: var(--color-accent);
  }
  .faq__answer {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .faq__item[open] .faq__answer { grid-template-rows: 1fr; }
  .faq__answer > div { overflow: hidden; }
  .faq__answer p {
    padding: 0 var(--space-sm) var(--space-md);
    font-size: var(--text-base); color: var(--color-neutral);
    max-width: 800px;
  }
  .faq__answer strong { color: var(--color-primary); }

  .faq__more { max-width: var(--container-max); margin: var(--space-lg) auto 0; text-align: center; }
  .faq__more a { font-size: var(--text-sm); color: var(--color-neutral); text-decoration: underline; text-underline-offset: 4px; }
  .faq__more a:hover { color: var(--color-accent-ink); }

  [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  [data-reveal].is-in { opacity: 1; transform: none; }

  @media (max-width: 768px) {
    .faq__title { font-size: var(--text-2xl); }
    .faq__question { font-size: var(--text-base); }
    [data-reveal] { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__answer { transition: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = Array.from(document.querySelectorAll('.faq [data-reveal]'));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.1 });
    items.forEach((el) => io.observe(el));
  });
</script>
