---
import Button from "../Button/Button.astro"
import PriceBand from "./PriceBand.astro"
import { offer } from "../../data/offre"
// Offer — homepage teaser: 6 inclusions, prix, TCO, CTA. Le détail vit sur /offre.

const homeIncluded = offer.included.filter((item) =>
  [
    "Rebranding",
    "Design",
    "Pages sans surcoût",
    "SEO technique",
    "CMS Storyblok",
    "Support humain"
  ].includes(item.title)
)
---

<section class="offer" id="offre">
  <div class="offer__header">
    <p class="offer__eyebrow">L'offre unique</p>
    <h2 class="offer__title">
      Tout <span class="offer__accent">compris.</span>
    </h2>
    <p class="offer__subtitle">Rebranding, design, déploiement.</p>
  </div>

  <PriceBand />

  <div class="offer__included" data-reveal>
    <h3 class="offer__block-title">Tout est inclus</h3>
    <ul class="offer__grid">
      {
        homeIncluded.map((item) => (
          <li class="offer__item">
            <svg
              class="offer__check"
              width="18"
              height="18"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true">
              <>
                <circle
                  cx="10"
                  cy="10"
                  r="9"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 10l3 3 5-6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </>
            </svg>
            <div>
              <strong>{item.title}</strong>
              <span set:html={item.desc}></span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Calendrier, options et comparatif détaillé : page /offre -->

  <div class="offer__cta" data-reveal>
    <Button href="/contact">Démarrer mon projet</Button>
    <p class="offer__fineprint">
      Pas d'applis natives, pas de WordPress — on ne fait que des sites sur
      notre stack, et on les fait bien. Le site, son code et ses contenus vous
      appartiennent.
    </p>
    <a class="offer__details" href="/offre">Voir l'offre en détail →</a>
  </div>
</section>

<style>
  .offer {
    background-color: var(--color-secondary);
    padding: var(--space-3xl) var(--container-padding);
  }
  .offer__header,
  .offer__included,
  .offer__cta {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .offer__included {
    margin-top: var(--space-xl);
  }
  .offer__eyebrow {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-neutral);
    margin-bottom: var(--space-sm);
  }
  .offer__title {
    color: var(--color-primary);
    font-size: var(--text-4xl);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .offer__accent {
    color: var(--color-argile);
  }
  .offer__subtitle {
    font-size: var(--text-lg);
    color: var(--color-neutral);
    max-width: 600px;
    margin-top: var(--space-md);
  }
  .offer__block-title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }
  .offer__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  .offer__item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: var(--space-md);
    border-radius: 12px;
    background: var(--color-neutral);
    border: 1px solid var(--line);
  }
  .offer__check {
    flex-shrink: 0;
    color: var(--color-secondary);
    margin-top: 2px;
  }
  .offer__item div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .offer__item strong {
    font-size: var(--text-base);
    color: var(--color-secondary);
  }
  .offer__item span {
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }
  .offer__item span :global(a) {
    color: var(--color-secondary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .offer__cta {
    margin-top: var(--space-xl);
    text-align: center;
  }
  .offer__details {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .offer__details:hover {
    color: var(--color-accent-ink);
  }
  .offer__fineprint {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 768px) {
    .offer__title {
      font-size: var(--text-2xl);
    }
    .offer__grid {
      grid-template-columns: 1fr;
    }
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const blocks = Array.from(document.querySelectorAll(".offer [data-reveal]"))
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            ;(e.target as HTMLElement).classList.add("is-in")
            io.unobserve(e.target)
          }
        }
      },
      { threshold: 0.1 }
    )
    blocks.forEach((b) => io.observe(b))
  })
</script>
