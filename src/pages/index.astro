---
import Layout from "../layouts/Layout.astro"
import Loader from "../components/Loader/Loader.astro"
import Hero from "../components/Hero/Hero.astro"
import InterfaceContrast from "../components/Hero/InterfaceContrast.astro"
import InterfaceSerenity from "../components/Hero/InterfaceSerenity.astro"
import Portfolio from "../components/Portfolio/Portfolio.astro"
---

<Layout>
  <Loader />
  <Hero />
  <InterfaceContrast />
  <InterfaceSerenity />
  <Portfolio />
</Layout>

<script>
  window.addEventListener("loaderComplete", () => {
    document.querySelector(".hero")?.classList.add("hero--visible")
  })
</script>

<style is:global>
  .hero {
    opacity: 0;
    transition: opacity 0.1s ease;
  }
  .hero--visible {
    opacity: 1;
  }
</style>
