---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button/Button.astro";
import Footer from "../components/Footer/Footer.astro";
---

<Layout
  title="Page introuvable — huitquatre"
  description="Cette page n'existe pas (ou plus). Le vide fait partie du concept."
>
  <main class="nf">
    <p class="nf__code">404</p>
    <h1 class="nf__title">
      Le vide <span class="nf__accent">fait</span> partie du concept.
    </h1>
    <p class="nf__text">
      Cette page n'existe pas — ou plus. Les quatre blocs, eux, sont toujours
      là.
    </p>
    <div class="nf__cta">
      <Button href="/">Retour au silence</Button>
      <Button href="/contact" theme="secondary">Démarrer mon projet</Button>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .nf {
    min-height: 62vh;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3xl) var(--container-padding);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-neutral);
    margin-bottom: var(--space-md);
  }
  .nf__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-primary);
    max-width: 16ch;
  }
  .nf__accent {
    color: var(--color-accent-ink);
  }
  .nf__text {
    font-size: var(--text-lg);
    color: var(--color-neutral);
    margin-top: var(--space-md);
    max-width: 46ch;
  }
  .nf__cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }
</style>
