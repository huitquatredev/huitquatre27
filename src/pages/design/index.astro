---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button/Button.astro";
import Footer from "../../components/Footer/Footer.astro";

// Palette — source unique : les tokens CSS. Le hex s'affiche au runtime.
const colors = [
  { name: "Lin", token: "--color-secondary", usage: "Fond de page et de toutes les sections", dark: false },
  { name: "Forêt", token: "--color-primary", usage: "Texte, titres, boutons primaires", dark: true },
  { name: "Vin", token: "--color-wine", usage: "Accent chaud, surfaces sur forêt", dark: true },
  { name: "Olive", token: "--color-accent-ink", usage: "Prix, accents, états — jamais en fond", dark: true },
  { name: "Argile", token: "--color-argile", usage: "Second temps des titres de sections", dark: true },
  { name: "Gris franc", token: "--color-neutral", usage: "Textes secondaires (contraste AA tenu)", dark: true },
  { name: "Alerte", token: "--color-alert", usage: "Erreurs uniquement", dark: true },
];

const scale = [
  { name: "Display", token: "--text-4xl", sample: "Votre site web." },
  { name: "Headline", token: "--text-3xl", sample: "1 990 €, une fois." },
  { name: "Title", token: "--text-2xl", sample: "Tout est inclus" },
  { name: "Lead", token: "--text-lg", sample: "Rebranding, design, déploiement." },
  { name: "Body", token: "--text-base", sample: "Site sur-mesure, payé une fois. Léger, rapide, sans abonnement." },
  { name: "Label", token: "--text-sm mono", sample: "AGENCE WEB (IM)PERTINENTE" },
];
---

<Layout
  title="Design system — huitquatre"
  description="Couleurs, typographies, boutons, rythme et composants du design system huitquatre."
  noindex
>
  <main class="ds">
    <header class="ds__header">
      <p class="ds__eyebrow">Design system</p>
      <h1 class="ds__title">Lisibilité <span class="ds__accent">avant tout.</span></h1>
      <p class="ds__intro">Grille suisse, accent campagne. Mêmes boutons, mêmes fontes, même rythme partout — l'olive signale, le reste se tait.</p>
    </header>

    <section class="ds__section">
      <h2 class="ds__h2">Couleurs</h2>
      <div class="ds__swatches">
        {colors.map((c) => (
          <div class="ds__swatch" style={`background:var(${c.token});color:${c.dark ? "var(--color-secondary)" : "var(--color-primary)"}`}>
            <strong>{c.name}</strong>
            <code data-token={c.token}>{c.token}</code>
            <span>{c.usage}</span>
          </div>
        ))}
      </div>
      <p class="ds__rule"><strong>The Signal Rule.</strong> L'olive signale une action, un prix ou un état — jamais une décoration.</p>
    </section>

    <section class="ds__section">
      <h2 class="ds__h2">Typographie</h2>
      <div class="ds__typegrid">
        <div class="ds__typefont">
          <strong>Space Grotesk</strong><span>Titres — 700, uppercase, chasse −0.03em</span>
          <p class="ds__aa" style="font-family:var(--font-display);font-weight:700;">Aa</p>
        </div>
        <div class="ds__typefont">
          <strong>Satoshi</strong><span>Texte courant — 400, interligne 1.6</span>
          <p class="ds__aa" style="font-family:var(--font-body);">Aa</p>
        </div>
        <div class="ds__typefont">
          <strong>JetBrains Mono</strong><span>Labels, prix, preuves</span>
          <p class="ds__aa" style="font-family:var(--font-mono);">Aa</p>
        </div>
      </div>
      <div class="ds__scale">
        {scale.map((s) => (
          <div class="ds__scalerow">
            <div class="ds__scalemeta"><strong>{s.name}</strong><code>{s.token}</code></div>
            <p class={`ds__samples ds__samples--${s.name}`}>{s.sample}</p>
          </div>
        ))}
      </div>
      <p class="ds__rule"><strong>The Two-Beat Rule.</strong> Les titres claquent en deux temps, le second en olive.</p>
    </section>

    <section class="ds__section">
      <h2 class="ds__h2">Boutons</h2>
      <p class="ds__note">Un seul système Osmo : pilule 2.5em, icône double au survol. Quatre thèmes, pas un de plus.</p>
      <div class="ds__btnrow">
        <Button href="/design">Primary</Button>
        <Button href="/design" theme="secondary">Secondary</Button>
        <Button href="/design" size="large">Large</Button>
        <Button href="/design" variant="ghost">Ghost →</Button>
      </div>
      <div class="ds__inverted">
        <Button href="/design" theme="inverted">Inverted</Button>
        <span>Inverted vit sur fond forêt uniquement.</span>
      </div>
    </section>

    <section class="ds__section">
      <h2 class="ds__h2">Rythme</h2>
      <div class="ds__spaces">
        {["xs", "sm", "md", "lg", "xl", "2xl", "3xl"].map((s) => (
          <div class="ds__spacerow"><code>--space-{s}</code><div class="ds__spacebar" style={`height:var(--space-${s})`}></div></div>
        ))}
      </div>
      <p class="ds__note">Conteneur 1200px · gouttières fluides · sections espacées de <code>--space-3xl</code> · bascule mobile 768px.</p>
    </section>

    <section class="ds__section">
      <h2 class="ds__h2">Composants</h2>
      <div class="ds__comps">
        <div class="ds__card"><strong>Rebranding</strong><span>On part de votre existant qu'on améliore, ou on crée de zéro.</span></div>
        <div class="ds__chips">
          <button type="button" class="ds__chip">Boutique en ligne</button>
          <button type="button" class="ds__chip is-on">Site vitrine</button>
        </div>
        <input class="ds__input" placeholder="Votre nom" aria-label="Exemple de champ" />
        <p><span class="ds__badge">100</span> <span class="ds__badge ds__badge--alert">12</span></p>
      </div>
      <p class="ds__note">Cartes plates 12px, zéro ombre · pastilles 6px · champs pilule, focus olive.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .ds { max-width: var(--container-max); margin: 0 auto; padding: var(--space-2xl) var(--container-padding) var(--space-3xl); }
  .ds__eyebrow { font-family: var(--font-mono); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-neutral); margin-bottom: var(--space-sm); }
  .ds__title { color: var(--color-primary); font-size: var(--text-4xl); }
  .ds__accent { color: var(--color-accent-ink); }
  .ds__intro { font-size: var(--text-lg); color: var(--color-neutral); max-width: 640px; margin-top: var(--space-md); }
  .ds__section { margin-top: var(--space-2xl); }
  .ds__h2 { font-size: var(--text-2xl); color: var(--color-primary); margin-bottom: var(--space-md); }
  .ds__note { color: var(--color-neutral); margin-top: var(--space-md); max-width: 640px; }
  .ds__rule { margin-top: var(--space-md); padding: var(--space-md) var(--space-lg); border-radius: 12px; background: var(--color-accent-light); border: 1px solid var(--accent-soft-border); }
  .ds__rule strong { color: var(--color-accent-ink); }
  .ds__swatches { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .ds__swatch { border-radius: 16px; padding: var(--space-lg); display: flex; flex-direction: column; gap: 4px; min-height: 170px; border: 1px solid var(--line); }
  .ds__swatch strong { font-family: var(--font-display); font-size: var(--text-xl); text-transform: uppercase; }
  .ds__swatch code { font-family: var(--font-mono); font-size: var(--text-sm); }
  .ds__swatch span { font-size: var(--text-sm); opacity: 0.8; }
  .ds__typegrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .ds__typefont { border: 1px solid var(--line); border-radius: 12px; padding: var(--space-md); background: var(--surface); display: flex; flex-direction: column; gap: 2px; }
  .ds__typefont strong { color: var(--color-primary); }
  .ds__typefont span { font-size: var(--text-sm); color: var(--color-neutral); }
  .ds__aa { font-size: 4rem; line-height: 1; color: var(--color-primary); margin-top: var(--space-sm); }
  .ds__scale { margin-top: var(--space-lg); border-top: 1px solid var(--line); }
  .ds__scalerow { display: grid; grid-template-columns: 220px 1fr; gap: var(--space-md); align-items: baseline; padding: var(--space-md) 0; border-bottom: 1px solid var(--line); }
  .ds__scalemeta strong { display: block; color: var(--color-primary); }
  .ds__scalemeta code { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-neutral); }
  .ds__samples { color: var(--color-primary); margin: 0; }
  .ds__samples--Display, .ds__samples--Headline, .ds__samples--Title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: -0.02em; }
  .ds__samples--Display { font-size: var(--text-4xl); line-height: 1.05; }
  .ds__samples--Headline { font-size: var(--text-3xl); }
  .ds__samples--Title { font-size: var(--text-2xl); }
  .ds__samples--Lead { font-size: var(--text-lg); color: var(--color-neutral); }
  .ds__samples--Body { font-size: var(--text-base); }
  .ds__samples--Label { font-family: var(--font-mono); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-neutral); }
  .ds__btnrow { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; }
  .ds__inverted { margin-top: var(--space-md); display: flex; align-items: center; gap: var(--space-md); background: var(--color-accent); border-radius: 16px; padding: var(--space-lg); color: var(--color-secondary); }
  .ds__spaces { display: flex; flex-direction: column; gap: var(--space-sm); }
  .ds__spacerow { display: grid; grid-template-columns: 120px 1fr; gap: var(--space-md); align-items: center; }
  .ds__spacerow code { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-neutral); }
  .ds__spacebar { background: var(--color-accent); border-radius: 2.5em; min-height: 4px; }
  .ds__comps { display: flex; flex-direction: column; gap: var(--space-md); max-width: 640px; }
  .ds__card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: var(--space-lg); display: flex; flex-direction: column; gap: 4px; }
  .ds__card strong { color: var(--color-primary); }
  .ds__card span { color: var(--color-neutral); font-size: var(--text-sm); }
  .ds__chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .ds__chip { padding: 8px 16px; border-radius: 2.5em; border: 1px solid var(--accent-chip-border); color: var(--color-accent-ink); font-weight: 700; font-size: var(--text-sm); }
  .ds__chip.is-on { background: var(--color-accent); color: var(--color-secondary); }
  .ds__input { padding: 10px 16px; border-radius: 2.5em; background: var(--input-bg); border: 1px solid var(--line-strong); color: var(--color-primary); font-size: var(--text-base); font-family: inherit; }
  .ds__input:focus { outline: none; border-color: var(--color-accent-ink); }
  .ds__badge { display: inline-flex; align-items: center; padding: 1px 6px; border-radius: 6px; background: rgba(72,199,100,0.2); color: #48c764; font-size: 11px; font-weight: 700; }
  .ds__badge--alert { background: rgba(255,51,51,0.12); color: var(--color-alert); }

  @media (max-width: 768px) {
    .ds__title { font-size: var(--text-2xl); }
    .ds__swatches, .ds__typegrid { grid-template-columns: 1fr; }
    .ds__scalerow { grid-template-columns: 1fr; gap: 2px; }
    .ds__spacerow { grid-template-columns: 90px 1fr; }
  }
</style>

<script>
  /* Affiche le hex reel de chaque token : le CSS reste la source unique. */
  document.querySelectorAll<HTMLElement>("[data-token]").forEach((el) => {
    const value = getComputedStyle(document.documentElement)
      .getPropertyValue(el.dataset.token || "")
      .trim();
    if (value) el.textContent = value.toUpperCase();
  });
</script>
