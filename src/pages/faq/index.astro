---
import Layout from "../../layouts/Layout.astro";
import FAQ from "../../components/FAQ/FAQ.astro";
import FinalCTA from "../../components/CTA/FinalCTA.astro";
import Footer from "../../components/Footer/Footer.astro";
import { generalFaq, prixFaq } from "../../data/faq";
---

<Layout
  title="FAQ — questions fréquentes | huitquatre"
  description="Toutes les réponses : propriété du site, frais, autonomie, délais, prix. Sans jargon, sans langue de bois."
>
  <FAQ items={generalFaq} />
  <FAQ
    items={prixFaq}
    eyebrow="Tarifs"
    titleA="Questions"
    titleB="prix."
    sectionId="faq-prix"
  />
  <FinalCTA />
  <Footer />
</Layout>
