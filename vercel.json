{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/agence-web-avignon", "destination": "/", "permanent": true },
    { "source": "/comment-creer-site-internet", "destination": "/offre", "permanent": true },
    { "source": "/devis-site-internet", "destination": "/contact", "permanent": true },
    { "source": "/test-site-web", "destination": "/offre", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/sitemap-0.xml", "destination": "/sitemap.xml", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "huitquatre27.vercel.app" }],
      "destination": "https://www.huitquatre.fr/$1",
      "permanent": true
    }
  ]
}
